# Bootstrap values for a HOSTED Vellum instance.
# These are the only values Vellum reads from the environment. Every other setting
# (AI providers, GitHub, import bounds, cost, simulation, privacy, budgets, webhooks)
# is edited in the app under Settings.
#
# The local profile (`docker compose up`) needs none of this file.

# --- Required -----------------------------------------------------------------

# Postgres connection string.
ConnectionStrings__DefaultConnection=Host=db.example.internal;Database=vellum;Username=vellum;Password=change-me

# Operating profile: `local` (default) or `hosted`.
Vellum__Profile=hosted

# Master key: the base64 form of 32 random bytes. It wraps the data key of every stored
# credential and of the keys that sign the session cookie.
# Create one with: openssl rand -base64 32
# Set exactly one of Vellum__MasterKey and Vellum__MasterKeyFile.
# The hosted profile does not start without a master key.
Vellum__MasterKey=
# Vellum__MasterKeyFile=/run/secrets/vellum-master-key

# The public host names of this instance, separated by ';'.
# The hosted profile does not start when this is `*`.
AllowedHosts=vellum.example.com

# One-time token for first-run setup, at least 16 characters. The person who creates the
# first admin account types it in the setup screen. The hosted profile does not start
# without it while the instance has no user. Remove it after setup.
# Create one with: openssl rand -hex 24
Vellum__SetupToken=

# --- Optional -----------------------------------------------------------------

# Key rotation. To change the master key:
#   1. Set Vellum__MasterKey to the new key and Vellum__PreviousMasterKey to the old key.
#   2. Restart, then call POST /api/instance/keys/rotate as the instance admin.
#   3. Remove Vellum__PreviousMasterKey and restart.
# The previous key only reads; nothing new is encrypted with it.
# Vellum__PreviousMasterKey=
# Vellum__PreviousMasterKeyFile=/run/secrets/vellum-previous-master-key

# Session cookies carry the Secure attribute in the hosted profile. This is the default;
# the hosted profile does not start when it is `false`. Serve the app over HTTPS.
# Vellum__SecureCookies=true

# Local profile only: where the generated master key file is kept (default ./data).
# Vellum__DataDirectory=/data

# Set to `false` when a separate deployment step applies the database migrations.
# Database__MigrateOnStartup=true

# Standard ASP.NET Core setting: honour X-Forwarded-Proto/For from a TLS-terminating proxy.
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Optional external sign-in providers.
# Authentication__GitHub__ClientId=
# Authentication__GitHub__ClientSecret=
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=
