# Bootstrap values for a HOSTED Vellum instance.
# These are the only values Vellum reads from the environment. Every other setting
# (AI providers, GitHub, import bounds, cost, simulation, privacy, budgets, webhooks)
# is edited in the app under Settings.
#
# The local profile (`docker compose up`) needs none of this file. The values that Docker
# Compose itself reads are at the end.

# --- Required -----------------------------------------------------------------

# Postgres connection string.
ConnectionStrings__DefaultConnection=Host=db.example.internal;Database=vellum;Username=vellum;Password=change-me

# Operating profile: `local` (default) or `hosted`.
Vellum__Profile=hosted

# Master key: the base64 form of 32 random bytes. It wraps the data key of every stored
# credential and of the keys that sign the session cookie.
# Create one with: openssl rand -base64 32
# Set exactly one of Vellum__MasterKey and Vellum__MasterKeyFile.
# The hosted profile does not start without a master key.
# Vellum does not start, in any profile, when the database holds stored credentials or
# session keys under a master key that is not loaded. The message names the missing key.
# If the key is lost: `dotnet Vellum.dll keys forget --yes` deletes those rows.
Vellum__MasterKey=
# Vellum__MasterKeyFile=/run/secrets/vellum-master-key

# The public host names of this instance, separated by ';'.
# The hosted profile does not start when an entry is `*`, contains `*`, is `0.0.0.0`,
# `::` or `[::]`, or is empty.
AllowedHosts=vellum.example.com

# One-time token for first-run setup, at least 16 characters. The person who creates the
# first admin account types it in the setup screen. The hosted profile does not start
# without it while the instance has no user. Remove it after setup.
# Create one with: openssl rand -hex 24
# The local profile needs none: it writes a generated setup code to its log (the line
# that contains "VELLUM SETUP CODE:") and to the file `setup-code` in its data directory.
Vellum__SetupToken=

# --- Optional -----------------------------------------------------------------

# Key rotation. To change the master key:
#   1. Set Vellum__MasterKey to the new key and Vellum__PreviousMasterKey to the old key.
#   2. Restart, then call POST /api/instance/keys/rotate as the instance admin.
#   3. Read `remaining` in the answer. When it is not 0, stop every instance that still
#      uses the old key as Vellum__MasterKey and call the endpoint again.
#   4. When `remaining` is 0, remove Vellum__PreviousMasterKey and restart.
# The previous key only reads; nothing new is encrypted with it.
# Vellum__PreviousMasterKey=
# Vellum__PreviousMasterKeyFile=/run/secrets/vellum-previous-master-key

# Session cookies carry the Secure attribute in the hosted profile. This is the default;
# the hosted profile does not start when it is `false`. Serve the app over HTTPS.
# In the hosted profile every URL in the settings (GitHub, AI providers, webhook) must
# use https, because a credential goes to it. Plain http passes only for a private host,
# and only when the instance policy allows private network URLs.
# Vellum__SecureCookies=true

# Local profile only: where the generated master key file (`master.key`) and the setup
# code (`setup-code`) are kept (default ./data). Vellum refuses a master.key that other
# users of the machine can read: chmod 600.
# Vellum__DataDirectory=/data

# Set to `false` when a separate deployment step applies the database migrations.
# Database__MigrateOnStartup=true

# Standard ASP.NET Core setting: honour X-Forwarded-Proto/For from a TLS-terminating proxy.
# Set it behind a proxy: the rate limit for sign-in and setup counts by client address.
# ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Optional external sign-in providers. A provider sign-in never takes over an existing
# account with the same email address.
# Authentication__GitHub__ClientId=
# Authentication__GitHub__ClientSecret=
# Authentication__Google__ClientId=
# Authentication__Google__ClientSecret=

# --- Docker Compose only ------------------------------------------------------
# docker-compose.yml reads these. Vellum itself does not.

# The address that publishes the app port. The default accepts connections from this
# machine only. Set 0.0.0.0 to accept other machines, behind HTTPS.
# VELLUM_BIND=127.0.0.1
# VELLUM_PORT=8080

# The address that publishes the database port. The Compose database has a well-known
# password: change this only on a network that you trust.
# VELLUM_POSTGRES_BIND=127.0.0.1
# VELLUM_POSTGRES_PORT=5432

# Passed to Vellum as Vellum__MasterKey, Vellum__PreviousMasterKey and Vellum__SetupToken.
# Empty means "not set".
# VELLUM_MASTER_KEY=
# VELLUM_PREVIOUS_MASTER_KEY=
# VELLUM_SETUP_TOKEN=
