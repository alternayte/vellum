  "schemas": [
    {
      "id": "e0a1d5c0-15ed-4000-8003-000000000030",
      "name": "PaymentRequest",
      "description": "The body of POST /payments. The amount is in minor units.",
      "content": "{\"type\":\"object\",\"required\":[\"amount\",\"currency\",\"cardToken\"],\"properties\":{\"amount\":{\"type\":\"integer\",\"minimum\":1},\"currency\":{\"type\":\"string\",\"pattern\":\"^[A-Z]{3}$\"},\"cardToken\":{\"type\":\"string\",\"minLength\":1}},\"additionalProperties\":false}",
      "version": 1,
      "factStatus": "declared",
      "provenance": null
    },
    {
      "id": "e0a1d5c0-15ed-4000-8003-000000000031",
      "name": "PaymentResult",
      "description": "The answer of POST /payments.",
      "content": "{\"type\":\"object\",\"required\":[\"paymentId\",\"status\"],\"properties\":{\"paymentId\":{\"type\":\"string\",\"pattern\":\"^p-[0-9]+$\"},\"status\":{\"enum\":[\"pending\",\"captured\",\"declined\"]}},\"additionalProperties\":false}",
      "version": 1,
      "factStatus": "declared",
      "provenance": null
    },
    {
      "id": "e0a1d5c0-15ed-4000-8003-000000000032",
      "name": "RiskRequest",
      "description": "The body of POST /risk-checks.",
